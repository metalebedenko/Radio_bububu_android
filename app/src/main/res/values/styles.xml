<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:colorAccent">#216A55</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAF9F5</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="NeoTheme" parent="AppTheme">
        <item name="android:colorAccent">#216A55</item>
        <item name="android:windowBackground">#FAF9F5</item>
    </style>
    <style name="BubbleTheme" parent="AppTheme">
        <item name="android:colorAccent">#365F8B</item>
        <item name="android:windowBackground">#F4F6F9</item>
    </style>
</resources>
